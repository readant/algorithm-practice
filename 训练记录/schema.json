{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://algorithm-practice/训练记录/schema.json",
  "title": "训练记录 v1.0",
  "description": "日常训练的唯一真值源。一天一个文件。只存真实事实（平台判定 / 原始代码 / 独立完成度），不存派生量。",
  "type": "object",
  "required": ["schema_version", "date", "platform", "evidence_level", "problems"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "_说明": { "type": "string" },

    "date": { "type": "string", "format": "date", "description": "训练日；批量/区间记录时写区间结束日" },
    "date_range": { "type": ["string", "null"], "description": "批量记录用，如 2026-07-16~2026-08-10" },
    "platform": { "enum": ["洛谷", "牛客", "蓝桥", "Codeforces", "AtCoder", "LeetCode", "AcWing", "自选题", "其他"] },
    "evidence_level": {
      "enum": ["强", "中", "弱"],
      "description": "强=平台判定+原始代码；中=自述+截图；弱=仅题号/题单记载（弱证据不参与独立AC率）"
    },
    "source": { "type": ["string", "null"], "description": "如「平台提交记录」「自述」「progress.md 记载」" },
    "evidence_files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "相对 训练记录/证据/ 的截图路径"
    },
    "notes": { "type": ["string", "null"] },

    "problems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "verdict"],
        "properties": {
          "id": { "type": "string", "description": "题号，如 P1000 / A / CF-1234A" },
          "title": { "type": ["string", "null"] },
          "verdict": {
            "enum": ["AC", "WA", "TLE", "RE", "CE", "未过", "未做"],
            "description": "平台判定；未提交写 未做"
          },
          "attempts": { "type": ["integer", "null"], "description": "提交次数；记不清写 null，不要估" },
          "minutes": { "type": ["number", "null"], "description": "本题耗时（分钟）；记不清写 null" },
          "independent": {
            "enum": ["独立", "卡住后自己过", "看题解后过", null],
            "description": "核心防伪字段：是否独立完成。未记录写 null"
          },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "题型标签，如 模拟/贪心/DP" },
          "code_file": {
            "type": ["string", "null"],
            "description": "相对 训练记录/原始代码/ 的路径；填了才可能构成强证据"
          },
          "notes": { "type": ["string", "null"] }
        }
      }
    }
  }
}
